# Optional local demo settings. The application uses these safe defaults when unset.
DEMO_MODE=true
SHOW_INTERNAL_COSTS=false
ENABLE_LLM=false
PRICING_DATA_MODE=synthetic

# --- Database -------------------------------------------------------------
# PostgreSQL is the target for internal MVP environments.
# SQLite is supported for local development and automated tests only.
#
# NEVER commit real credentials. Copy this file to .env and edit locally;
# .env is git-ignored.
#
# Local development (default when DATABASE_URL is unset):
DATABASE_URL=sqlite+pysqlite:///./quotation_ai.db
#
# Automated tests use a throwaway in-memory database and need no variable:
#   sqlite+pysqlite:///:memory:
#
# Internal MVP (PostgreSQL). Replace every placeholder with values supplied
# out of band; do not store real credentials in source control:
# DATABASE_URL=postgresql+psycopg2://<user>:<password>@<host>:5432/<database>

# Echo SQL to stderr. Development troubleshooting only.
DATABASE_ECHO=false

# --- Offline SAP Excel ingestion (Phase 2) --------------------------------
# No live SAP connection exists. Only offline .xlsx/.xlsm exports are read.
#
# Where uploaded workbooks are stored. This MUST point outside the repository
# (or at an object-storage mount). Raw workbooks are never committed.
INGESTION_STORAGE_ROOT=./var/pricing_uploads
#
# Comma-separated currency allowlist. Rows in other currencies are rejected.
INGESTION_SUPPORTED_CURRENCIES=USD,EUR,GBP,CNY,JPY,AUD,CAD
#
# Upload size ceiling in bytes (default 50 MB).
INGESTION_MAX_UPLOAD_BYTES=52428800
#
# Regular expression that a normalised region code must match.
INGESTION_REGION_PATTERN=^[A-Z]{2,3}(-[A-Z0-9]{1,3})?$

# --- AI agent providers (Phase 3) -----------------------------------------
# All four agents default to deterministic mode. No API key is required and no
# external call is made. Each agent can be switched independently.
# Providers: deterministic | mock | http_json | openai_compatible
# Never put an API key in this file: set only the *name* of the variable that
# holds it via AGENTn_API_KEY_ENV, and export the key out of band.
AGENT1_PROVIDER=deterministic
AGENT1_BASE_URL=
AGENT1_API_KEY_ENV=AGENT1_API_KEY
AGENT1_MODEL=
AGENT1_TIMEOUT_SECONDS=30

AGENT2_PROVIDER=deterministic
AGENT2_BASE_URL=
AGENT2_API_KEY_ENV=AGENT2_API_KEY
AGENT2_MODEL=
AGENT2_TIMEOUT_SECONDS=30

AGENT3_PROVIDER=deterministic
AGENT3_BASE_URL=
AGENT3_API_KEY_ENV=AGENT3_API_KEY
AGENT3_MODEL=
AGENT3_TIMEOUT_SECONDS=30

AGENT4_PROVIDER=deterministic
AGENT4_BASE_URL=
AGENT4_API_KEY_ENV=AGENT4_API_KEY
AGENT4_MODEL=
AGENT4_TIMEOUT_SECONDS=30

# Optional per agent:
# AGENTn_MAX_RETRIES=0
# AGENTn_ORGANISATION=
# AGENTn_PROJECT=
# AGENTn_PROMPT_TEMPLATE_VERSION=v1

# --- Email delivery and approval reminders (Phase 7) ----------------------
# Delivery provider: console | smtp | graph. Console is the safe default and
# never leaves the machine.
EMAIL_DELIVERY_PROVIDER=console
EMAIL_SENDER_ADDRESS=
# Comma-separated internal domains. Internal emails may only be delivered to
# these domains.
EMAIL_INTERNAL_DOMAINS=
# Customer-facing delivery must be enabled deliberately.
EMAIL_ALLOW_CUSTOMER_DELIVERY=false
# Send the approval-request email automatically on submission.
EMAIL_AUTO_SEND_APPROVAL_REQUEST=false
# Body retention policy: hash | redacted | full.
EMAIL_BODY_STORAGE=hash
EMAIL_MAX_DELIVERY_ATTEMPTS=3
EMAIL_TEMPLATE_VERSION=v1

# Two calendar days by default. The due time is persisted at submission.
APPROVAL_REMINDER_DELAY_HOURS=48
APPROVAL_REMINDER_MAX_COUNT=1

# SMTP. Never put the password here: set only the *name* of the variable that
# holds it, and export the password out of band.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD_ENV=SMTP_PASSWORD
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=30

# Microsoft Graph. The adapter stays disabled until every setting is present.
# As with SMTP, only variable *names* are configured here.
GRAPH_ENABLED=false
GRAPH_TENANT_ID_ENV=GRAPH_TENANT_ID
GRAPH_CLIENT_ID_ENV=GRAPH_CLIENT_ID
GRAPH_CLIENT_SECRET_ENV=GRAPH_CLIENT_SECRET
GRAPH_SENDER_USER_ID=
GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
