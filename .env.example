# Optional local demo settings. The application uses these safe defaults when unset.
DEMO_MODE=true
SHOW_INTERNAL_COSTS=false
ENABLE_LLM=false
PRICING_DATA_MODE=synthetic

# --- Database -------------------------------------------------------------
# PostgreSQL is the target for internal MVP environments.
# SQLite is supported for local development and automated tests only.
#
# NEVER commit real credentials. Copy this file to .env and edit locally;
# .env is git-ignored.
#
# Local development (default when DATABASE_URL is unset):
DATABASE_URL=sqlite+pysqlite:///./quotation_ai.db
#
# Automated tests use a throwaway in-memory database and need no variable:
#   sqlite+pysqlite:///:memory:
#
# Internal MVP (PostgreSQL). Replace every placeholder with values supplied
# out of band; do not store real credentials in source control:
# DATABASE_URL=postgresql+psycopg2://<user>:<password>@<host>:5432/<database>

# Echo SQL to stderr. Development troubleshooting only.
DATABASE_ECHO=false

# --- Offline SAP Excel ingestion (Phase 2) --------------------------------
# No live SAP connection exists. Only offline .xlsx/.xlsm exports are read.
#
# Where uploaded workbooks are stored. This MUST point outside the repository
# (or at an object-storage mount). Raw workbooks are never committed.
INGESTION_STORAGE_ROOT=./var/pricing_uploads
#
# Comma-separated currency allowlist. Rows in other currencies are rejected.
INGESTION_SUPPORTED_CURRENCIES=USD,EUR,GBP,CNY,JPY,AUD,CAD
#
# Upload size ceiling in bytes (default 50 MB).
INGESTION_MAX_UPLOAD_BYTES=52428800
#
# Regular expression that a normalised region code must match.
INGESTION_REGION_PATTERN=^[A-Z]{2,3}(-[A-Z0-9]{1,3})?$
