{
  "openapi": "3.0.1",
  "info": {
    "title": "merge_requirements",
    "description": "把已校验候选合并进会话草稿：高置信度（≥0.7）静默合并，低置信度挂起并返回确认问题；用户确认后再次调用带 confirmations 落库。多轮澄清场景使用（可选工具）。",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8000",
      "description": "Quotation Bot API 服务地址（导入后请替换为实际部署地址）"
    }
  ],
  "paths": {
    "/api/v1/requirements/merge": {
      "post": {
        "operationId": "merge_requirements",
        "summary": "需求候选合并",
        "description": "把置信度 ≥0.7 的已校验候选静默合并进会话报价草稿，低置信度候选挂起为待确认项（封装 requirement_intake.merge_candidates）。Agent 参数指引：session_id（必填，取会话变量）、candidates（必填，取 validate_requirement_fields 的 accepted 输出）、confirmations（选填，用户确认后回传）。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["session_id", "candidates"],
                "properties": {
                  "session_id": {
                    "type": "string",
                    "description": "会话/草稿 ID，保证多轮对话合并到同一草稿"
                  },
                  "candidates": {
                    "type": "array",
                    "description": "已通过字段校验的候选值",
                    "items": {
                      "type": "object",
                      "required": ["field_name", "value", "confidence"],
                      "properties": {
                        "field_name": {
                          "type": "string"
                        },
                        "value": {
                          "type": "string"
                        },
                        "confidence": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        }
                      }
                    }
                  },
                  "confirmations": {
                    "type": "array",
                    "description": "用户对挂起项的确认/否决",
                    "items": {
                      "type": "object",
                      "properties": {
                        "field_name": {
                          "type": "string"
                        },
                        "confirmed": {
                          "type": "boolean"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "合并完成",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "merged": {
                      "type": "array",
                      "description": "本次成功写入草稿的字段（confidence ≥ 0.7 或已确认）",
                      "items": {
                        "type": "object",
                        "properties": {
                          "field_name": {
                            "type": "string"
                          },
                          "value": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "pending_confirmations": {
                      "type": "array",
                      "description": "挂起待用户确认的低置信度候选",
                      "items": {
                        "type": "object",
                        "properties": {
                          "field_name": {
                            "type": "string"
                          },
                          "value": {
                            "type": "string"
                          },
                          "confidence": {
                            "type": "number"
                          },
                          "question": {
                            "type": "string",
                            "description": "向用户复述确认的问题文本"
                          }
                        }
                      }
                    },
                    "rejected": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "field_name": {
                            "type": "string"
                          },
                          "raw_value": {
                            "type": "string"
                          },
                          "reason": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "draft_snapshot": {
                      "type": "object",
                      "description": "合并后的草稿字段全量视图"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
