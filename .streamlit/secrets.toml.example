# Streamlit secrets TEMPLATE for the Quotation-AI demo (Phase 9).
#
# Copy to `.streamlit/secrets.toml` locally, or paste the contents into the
# Streamlit Community Cloud "Secrets" editor. NEVER commit a real secret:
# `.streamlit/secrets.toml` is git-ignored.
#
# EVERY key below is OPTIONAL. With no secrets at all the application starts
# in deterministic demo mode: Agents 1-4 use deterministic providers, pricing
# uses the synthetic dataset, and storage uses a throwaway SQLite database.
#
# Keys must be defined at the top level (not inside a [section]); the
# application promotes only the allow-listed names below to environment
# variables, and an existing environment variable always wins.

# --- Demo safety switches -------------------------------------------------
# Keep these values for a public demo.
DEMO_MODE = "true"
SHOW_INTERNAL_COSTS = "false"
ENABLE_LLM = "false"
PRICING_DATA_MODE = "synthetic"

# --- Storage --------------------------------------------------------------
# Streamlit Community Cloud does not guarantee persistent local storage.
# auto           : local SQLite file when writable, otherwise a temporary file
# temporary_file : always a throwaway SQLite file in the OS temp directory
# memory         : in-memory SQLite, discarded on every process restart
# local_file     : ./quotation_ai.db
DEMO_DATABASE_MODE = "auto"
#
# Optional external database. Omit it for the demo. Never paste a production
# connection string into a public demo.
# DATABASE_URL = "postgresql+psycopg2://<user>:<password>@<host>:5432/<database>"

# --- Optional AI agents (Agent 1-4) ---------------------------------------
# Providers: deterministic (default) | mock | http_json | openai_compatible
# Missing values are never an error; the agent stays deterministic and every
# failed remote call falls back to the deterministic result.
#
# Agent 1 — requirement understanding
# AGENT1_PROVIDER = "openai_compatible"
# AGENT1_API_KEY = "<api-key>"
# AGENT1_BASE_URL = "https://<endpoint>/v1"
# AGENT1_MODEL = "<model-name>"
#
# Agent 2 — pricing explanation (never changes a price, cost or decision)
# AGENT2_PROVIDER = "deterministic"
# AGENT2_API_KEY = "<api-key>"
# AGENT2_BASE_URL = "https://<endpoint>/v1"
# AGENT2_MODEL = "<model-name>"
#
# Agent 3 — email drafting
# AGENT3_PROVIDER = "deterministic"
# AGENT3_API_KEY = "<api-key>"
# AGENT3_BASE_URL = "https://<endpoint>/v1"
# AGENT3_MODEL = "<model-name>"
#
# Agent 4 — document narrative
# AGENT4_PROVIDER = "deterministic"
# AGENT4_API_KEY = "<api-key>"
# AGENT4_BASE_URL = "https://<endpoint>/v1"
# AGENT4_MODEL = "<model-name>"

# --- Optional email delivery ----------------------------------------------
# The console provider is the safe default and never leaves the container.
# EMAIL_DELIVERY_PROVIDER = "console"
# EMAIL_SENDER_ADDRESS = "demo@example.invalid"
# EMAIL_INTERNAL_DOMAINS = "example.invalid"
# EMAIL_ALLOW_CUSTOMER_DELIVERY = "false"
